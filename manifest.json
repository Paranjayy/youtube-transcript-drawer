{
  "manifest_version": 3,
  "name": "YouTube Auto-Transcript Drawer",
  "version": "1.1.0",
  "description": "Automatically opens and displays a beautiful, interactive transcript panel on YouTube watch pages with playlist extraction.",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["jszip.min.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
